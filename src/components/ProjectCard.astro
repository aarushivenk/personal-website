---
import type { CollectionEntry } from 'astro:content';
import Frame from './Frame.astro';

interface Props { project: CollectionEntry<'work'> }
const { project } = Astro.props;
const d = project.data;
---
<article class="card">
  <a href={`/work/${project.id}/`} class="link">
    <Frame tint={d.tint} image={d.cover} alt={d.coverAlt} bleed={d.coverBleed} />
    <div class="text">
      <div class="row">
        <h2 class="title">{d.title}</h2>
        <p class="when">{d.company}, {d.years}</p>
      </div>
      <p class="summary">{d.summary}</p>
      <p class="tags">{d.tags.join(' / ')}</p>
    </div>
  </a>
</article>

<style>
  .link { display: block; text-decoration: none; }
  .link :global(.frame) { transition: transform .35s cubic-bezier(.2,.7,.2,1); }
  .link:hover :global(.frame) { transform: translateY(-3px); }
  .link:hover .title { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }

  .text { padding-top: 16px; }
  .row { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; }
  .title { font-size: var(--fs-sm); font-weight: 500; letter-spacing: 0; }
  .when { font-size: var(--fs-sm); color: var(--muted); white-space: nowrap; }
  .summary { margin-top: 6px; font-size: var(--fs-sm); color: var(--text-2); max-width: 54ch; }
  .tags { margin-top: 6px; font-size: var(--fs-xs); color: var(--muted); }

  @media (max-width: 520px) {
    .row { flex-direction: column; gap: 2px; }
  }
</style>
